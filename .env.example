# Server
PORT=3000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/artisans

# Security
# Generate a secret: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacez-moi
# Tokens (défaut : dérivés de SESSION_SECRET si non définis)
# ACCESS_TOKEN_SECRET=
# REFRESH_TOKEN_SECRET=
# ACCESS_TOKEN_TTL=3600
# REFRESH_TOKEN_TTL=86400

# Storage
UPLOAD_DIR=uploads

# Session flags
# COOKIE_SECURE=false

# Admin Seed
ADMIN_PHONE=0600000001
ADMIN_PASSWORD=changez-moi-123